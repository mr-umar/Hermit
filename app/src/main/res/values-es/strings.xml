    <!-- First Run Onboarding -->
    <string name="onboarding_welcome_title">Bienvenido a Hermit</string>
    <string name="onboarding_welcome_desc">Un santuario físico y tranquilo frente a las distracciones digitales. Controla el enfoque de tu teléfono con etiquetas NFC reales.</string>
    <string name="onboarding_step1_title">1. Ancla física</string>
    <string name="onboarding_step1_desc">Graba cualquier etiqueta NFC accesible (NTAG213, NTAG215, NTAG216) para que funcione como tu llave física de concentración. Déjala en tu escritorio o en otra habitación.</string>
    <string name="onboarding_step2_title">2. Bloqueo real de apps</string>
    <string name="onboarding_step2_desc">Hermit utiliza el Servicio de Accesibilidad de Android para detectar con fiabilidad cuando se abre una app bloqueada y guiarte con serenidad de regreso a tu objetivo.</string>
    <string name="onboarding_step3_title">3. Privacidad absoluta</string>
    <string name="onboarding_step3_desc">Sin cuentas, sin sincronización en la nube, sin rastreo. Tu lista de aplicaciones y tus hábitos permanecen estrictamente privados en este dispositivo.</string>
    <string name="onboarding_btn_enable_service">Conceder permiso de accesibilidad</string>
    <string name="onboarding_btn_continue">Comenzar</string>
    <string name="onboarding_permission_banner">El servicio de accesibilidad es indispensable para que funcione el bloqueo de aplicaciones.</string>

