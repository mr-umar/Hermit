    <string name="onboarding_welcome_title">Welcome to Hermit</string>
    <string name="onboarding_welcome_desc">A tranquil, physical sanctuary from digital distractions. Control your phone\'s focus with real NFC tags.</string>
    <string name="onboarding_step1_title">1. Physical Anchor</string>
    <string name="onboarding_step1_desc">Write any affordable NFC tag (NTAG213, NTAG215, NTAG216) to act as your physical focus key. Leave it on your desk or another room.</string>
