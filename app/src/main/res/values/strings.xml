    <!-- First Run Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Hermit</string>
    <string name="onboarding_welcome_desc">A tranquil, physical sanctuary from digital distractions. Control your phone\'s focus with real NFC tags.</string>
    <string name="onboarding_step1_title">1. Physical Anchor</string>
    <string name="onboarding_step1_desc">Write any affordable NFC tag (NTAG213, NTAG215, NTAG216) to act as your physical focus key. Leave it on your desk or another room.</string>
    <string name="onboarding_step2_title">2. Genuine App Blocking</string>
    <string name="onboarding_step2_desc">Hermit uses Android\'s Accessibility Service to reliably detect when a blocked app opens and gently guide you back to focus.</string>
    <string name="onboarding_step3_title">3. Privacy First</string>
    <string name="onboarding_step3_desc">No accounts, no cloud sync, no tracking. Your app list and habits remain strictly private on this device.</string>
    <string name="onboarding_btn_enable_service">Grant Accessibility Permission</string>
    <string name="onboarding_btn_continue">Get Started</string>
    <string name="onboarding_permission_banner">Accessibility Service is required for app blocking to function.</string>

